# ============================================================
# NADI - Navigasi AI Data Intervensi
# Salin berkas ini menjadi ".env" lalu isi nilainya.
#   cp .env.example .env
# Berkas .env TIDAK PERNAH di-commit ke git.
# ============================================================

# ---------- Aplikasi ----------
NADI_ENV=development
NADI_DEBUG=true
NADI_HOST=127.0.0.1
NADI_PORT=8000

# ---------- Keamanan ----------
# WAJIB diganti sebelum dipakai di luar laptop.
# Hasilkan dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
NADI_SECRET_KEY=ganti-nilai-ini-dengan-kunci-acak-yang-panjang
NADI_ACCESS_TOKEN_MINUTES=480

# ---------- Basis data ----------
# Lokal (bawaan, tanpa instalasi apa pun):
NADI_DATABASE_URL=sqlite:///./data/nadi.db
# Cloud PostgreSQL (contoh Neon/Supabase) - cukup ganti baris di atas:
# NADI_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# ---------- Layanan AI (Policy Copilot & penjelasan bahasa alami) ----------
# Kompatibel dengan endpoint gaya OpenAI mana pun.
# OpenCode Zen:
NADI_LLM_ENABLED=true
NADI_LLM_BASE_URL=https://opencode.ai/zen/v1
NADI_LLM_API_KEY=isi-api-key-anda-di-sini
NADI_LLM_MODEL=
NADI_LLM_TIMEOUT_SECONDS=60
NADI_LLM_MAX_TOKENS=2400
NADI_LLM_TEMPERATURE=0.2

# ---------- Privasi (JANGAN diubah tanpa alasan hukum yang jelas) ----------
# Bila true, permintaan berisi data pribadi akan DITOLAK sebelum keluar dari server.
NADI_LLM_BLOCK_PII=true
# Pseudonimisasi identitas keluarga pada seluruh respons API.
NADI_PSEUDONYMIZE=true
